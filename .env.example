# GitHub App numeric id from the app settings page.
GITHUB_APP_ID=

# Public slug of the GitHub App. Required. There is no slug in code.
# Install URL: https://github.com/apps/$GITHUB_APP_SLUG/installations/new
GITHUB_APP_SLUG=

# GitHub App private key, PEM. Keep it on one line with \n for newlines.
# Never commit the real key. *.pem is gitignored.
GITHUB_APP_PRIVATE_KEY=

# Webhook secret you set when registering the GitHub App.
GITHUB_WEBHOOK_SECRET=

# OAuth client id of the same GitHub App. Used for sign-in.
GITHUB_CLIENT_ID=

# OAuth client secret of the same GitHub App.
GITHUB_CLIENT_SECRET=

# Neon Postgres connection string for this app.
# Use a database that is separate from the marketing site BETA_DATABASE_URL.
# Prefer the direct (unpooled) URL for `prisma migrate deploy`.
DATABASE_URL=

# Read/write Neon connection for the marketing site's beta_application table.
# Used only by the admin applications pages. Server-only. Never expose this to the client.
# The role needs SELECT and UPDATE on beta_application.
MARKETING_DATABASE_URL=

# xAI API key. Heavy Copilot jobs use grok-build-0.1.
# In development, a fake provider is used when this is empty.
# In production, heavy jobs fail closed when this is empty.
XAI_API_KEY=

# Resend API key. Used for branded sign-in, account, beta, announcement, and ops email.
# In development, codes are not sent when this is empty. Set LOGIN_CODE_SINK to keep them locally.
# Production refuses to send when this is empty.
RESEND_API_KEY=

# Verified Resend sender, for example Dokks <beta@your-domain>.
# Required together with RESEND_API_KEY before an email is sent.
RESEND_FROM=

# Local file for sign-in codes when Resend is not configured.
# Example: .local/login-codes.log
# Ignored when NODE_ENV is production. Never commit the file. Never put a real code here.
LOGIN_CODE_SINK=

# HMAC secret for signed dynamic OG images. Required in production.
# Development uses a local stand-in when this is empty.
OG_SIGNING_SECRET=

# Signs the session cookie and email preference links. Required in production.
# Development uses a local stand-in when this is empty.
SESSION_SECRET=

# Comma-separated emails that are approved for the beta and signed in as admins.
# Use this to create the first admin in production. They become an admin the next time they sign in.
# An email removed from this list keeps an existing admin role. Further sign-ins then require a BetaAccess row.
# Example: you@example.com,other@example.com
ADMIN_EMAILS=

# Public product name. Shown in the app, emails, and the docs agent. Required.
NEXT_PUBLIC_PRODUCT_NAME=Dokks

# Marketing site origin. Terms, privacy, subprocessors, the docs pill, and the Docs nav use it. Required.
NEXT_PUBLIC_MARKETING_URL=

# Default primary color for a new site, as #RRGGBB. Required.
# Keep the value quoted. An unquoted # is read as a comment, so the color is empty.
NEXT_PUBLIC_BRAND_PRIMARY="#2A2AD6"

# Optional email footer links. Leave empty to omit them.
SOCIAL_X_URL=
SOCIAL_GITHUB_URL=

# Public URL of this app. Required. Callback and setup URLs are derived from it.
APP_URL=

# Extra hosts that serve this app, comma-separated. The host of APP_URL is always included.
# Local development also accepts localhost and 127.0.0.1.
APP_HOSTS=

# Root domain for docs subdomains: {subdomain}.DOCS_ROOT_DOMAIN. Required.
DOCS_ROOT_DOMAIN=

# Optional model overrides.
# Heavy default is grok-build-0.1. grok-4.7 is a config option only.
XAI_HEAVY_MODEL=grok-build-0.1
# Small tasks use the same Grok build model. grok-4.1-fast is not a current API model id.
XAI_SMALL_MODEL=grok-build-0.1

# Internal USD estimates used only for daily caps. They are not an invoice.
# grok-build-0.1 list prices: $1 input and $2 output per million tokens.
XAI_INPUT_USD_PER_MTOK=1
XAI_OUTPUT_USD_PER_MTOK=2


# Per-repo and global daily spend caps, in USD.
REPO_DAILY_CAP_USD=2
GLOBAL_DAILY_CAP_USD=25

# Worker settings. Run the worker as a separate container, not in Vercel.
# Use 2 concurrent jobs and 1 heavy job per worker container in the beta.
WORKER_CONCURRENCY=2
MAX_CONCURRENT_HEAVY=1
WORKER_POLL_MS=1000
WORKER_LEASE_MS=300000
WORKER_HEARTBEAT_MS=30000
WORKER_REAPER_MS=60000
# Optional stable worker name. Defaults to a pid and random suffix.
WORKER_ID=

# How long a cached repo summary is reused, in hours.
SUMMARY_TTL_HOURS=24

# Set to 1 to show plan prices on the billing page. Hidden during beta.
SHOW_PLAN_PRICES=0

# Set to 1 in local development to open the dashboard without GitHub keys.
# Ignored when NODE_ENV is production.
AUTH_DEV_BYPASS=0

# Set to fake to force the fake Copilot provider even when API keys exist.
# Leave empty in production.
COPILOT_PROVIDER=

# Vercel Blob token for profile pictures. Uploads fail with an honest
# configuration error when this is empty.
BLOB_READ_WRITE_TOKEN=

# Spend alert thresholds in USD. The daily total is compared with the day's
# estimated AI spend. The user alert fires when one user is above the flat
# threshold and at least this multiple of the median spending user.
SPEND_ALERT_DAILY_USD=25
SPEND_ALERT_USER_USD=5
SPEND_ALERT_USER_MULTIPLE=5

# Comma-separated emails that receive spend alerts.
SPEND_ALERT_EMAILS=

# Bearer token for the protected spend-alert cron endpoint.
CRON_SECRET=
